# Meeting Assistant backend — required configuration.
# Copy to .env and fill in real values. Never commit .env (already gitignored).

PORT=3000

# Zoom Server-to-Server OAuth app (Zoom App Marketplace).
# Needs the recording:read scope on the account.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Microsoft Teams via Graph API — Azure AD app registration with application
# (not delegated) permissions granting access to online meeting recordings,
# admin-consented for the tenant.
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
# The UPN or object id of the meeting organizer whose recordings are read.
TEAMS_ORGANIZER_USER_ID=

# Google Meet via the Meet REST API — a Workspace service account with
# domain-wide delegation for the meetings.space.readonly and drive.readonly
# scopes.
GOOGLE_MEET_SERVICE_ACCOUNT_EMAIL=
# PEM private key from the service account's JSON key file. Keep it on one
# line with literal \n escapes for newlines (the code un-escapes them).
GOOGLE_MEET_PRIVATE_KEY=
# An admin or the meeting organizer the service account impersonates.
GOOGLE_MEET_IMPERSONATED_USER_EMAIL=

# Meeting workflow email. Default is draft-only: emails are drafted and approved but never sent,
# and no SMTP settings are needed. Set EMAIL_MODE=smtp to send for real (after the second approval).
EMAIL_MODE=draft-only
# SMTP settings, only used when EMAIL_MODE=smtp.
# For Gmail: smtp.gmail.com, port 465, and a Google app password as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Optional safety list: when set, email may only go to these addresses (comma separated).
SMTP_ALLOWED_RECIPIENTS=

# Calendar sync (Settings → Integrations). Read-only access; see docs/CALENDAR_SYNC_SETUP.md.
# Key that encrypts stored sign-in tokens (32 random bytes, base64). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Where the browser reaches this server; OAuth redirect URIs are built from it.
PUBLIC_BASE_URL=http://localhost:3000
# Google Cloud OAuth client (Web application). Redirect URI: <PUBLIC_BASE_URL>/api/calendar/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra app registration (Web platform). Redirect URI: <PUBLIC_BASE_URL>/api/calendar/oauth/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "common" = work/school + personal accounts; or your tenant id to allow only your organisation.
MS_TENANT=common

# Meeting notetaker (Recall.ai bot for Zoom / Teams / Google Meet). See docs/NOTETAKER_SETUP.md.
# Without a key the notetaker is off. The key stays on the server and is never sent to the browser.
RECALL_API_KEY=
# The region your Recall.ai workspace lives in: us-east-1, us-west-2, eu-central-1 or ap-northeast-1.
RECALL_REGION=us-east-1
# Signing secret (whsec_...) of the webhook endpoint <PUBLIC_BASE_URL>/api/notetaker/webhook in the
# Recall dashboard. Optional: without it, bot status is followed by polling every 20 seconds instead.
RECALL_WEBHOOK_SECRET=
